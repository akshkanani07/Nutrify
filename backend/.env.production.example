# ==============================================================================
# Nutrify AI — Backend Production Environment Configuration
# ==============================================================================

APP_ENV=production
APP_VERSION=2.0.0
AI_PROVIDER=ml_model
ALLOW_MOCK=false
ENABLE_ML_INTEGRATION=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=2

# Security & CORS
# Comma-separated list of allowed frontend origins (e.g. your production domain)
ALLOWED_ORIGINS=https://nutrify.yourdomain.com,http://localhost:3000
TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUST_EDGE_PROXY=true

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Model & Artifact Directory Paths
ML_DIR=/app/ml
MODEL_CHECKPOINT_PATH=/app/ml/models/production/nutrition_model_650_best.pt
CLASSES_JSON_PATH=/app/ml/models/production/classes_650.json
NUTRITION_MAPPING_PATH=/app/ml/models/production/nutrition_mapping_650.json

# Offline Guard (Ensure zero external network dependency at runtime)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

