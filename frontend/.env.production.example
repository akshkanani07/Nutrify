# ==============================================================================
# Nutrify AI — Frontend Production Environment Configuration (Vercel / Node)
# ==============================================================================

# Internal or public URL to the FastAPI backend service
BACKEND_API_URL=https://api.nutrify.yourdomain.com

# Edge proxy trust flag: set to 'true' when deployed behind Cloudflare, Vercel Edge, AWS CloudFront
TRUST_EDGE_PROXY=true

# Next.js Node environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
